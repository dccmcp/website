# Canonical origin used for metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://dccmcp.com

# Turn on Vercel Web Analytics (cookieless). Leave unset for self-hosted or
# air-gapped deployments so no third-party script is loaded.
# NEXT_PUBLIC_ANALYTICS=on

# Contact form transport. The form posts JSON to this URL and expects a 2xx.
# Until it is set, /api/contact returns 503 and the UI falls back to mailto.
# Point this at Resend, a HubSpot/Attio form endpoint, or your own service.
# CONTACT_WEBHOOK_URL=https://api.resend.com/emails
