# Canonical origin used for metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://dccmcp.com

# Turn on Vercel Web Analytics (cookieless). Leave unset for self-hosted or
# air-gapped deployments so no third-party script is loaded.
# NEXT_PUBLIC_ANALYTICS=on

# ---------------------------------------------------------------------------
# Contact form transport
#
# The form posts JSON to /api/contact. The route picks the first configured
# transport, in this order, and returns 503 (mailto fallback) if none is set:
#
#   1. ZeptoMail    ZEPTOMAIL_API_KEY + CONTACT_TO_EMAIL
#   2. Resend       RESEND_API_KEY    + CONTACT_TO_EMAIL
#   3. Webhook      CONTACT_WEBHOOK_URL
#
# CONTACT_TO_EMAIL is the inbox that receives enquiries. It must be a mailbox
# that can actually receive mail — dccmcp.com has no MX records, so an address
# on this domain only works once inbound routing is set up.
# ---------------------------------------------------------------------------

# ZeptoMail (Zoho) transactional mail. The API key is the "Send Mail Token"
# from the Mail Agent — the same value used as the SMTP password with the
# username `emailapikey`. Sent over the HTTP API, not SMTP.
# ZEPTOMAIL_API_KEY=
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email   # regional hosts: .in / .eu

# CONTACT_TO_EMAIL=support@dccmcp.com
# From address. Must be on a domain verified in ZeptoMail.
# CONTACT_FROM_EMAIL=DCCMCP <support@dccmcp.com>

# Alternative transport: Resend.
# RESEND_API_KEY=

# Alternative transport: any endpoint that accepts the enquiry as JSON.
# CONTACT_WEBHOOK_URL=https://example.com/inbound
